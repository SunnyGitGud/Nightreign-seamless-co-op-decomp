# Allowlist: only what is needed to build, test, package and understand the reconstruction is tracked.
# Everything else (analysis working dirs, runtime captures, build trees, logs) stays local. To track a new file outside
# these paths, add a "!" rule for it here.
/*
!/.gitignore
!/README.md
!/CMakeLists.txt
!/build.sh
!/build.ps1
!/cmake/
!/src/
!/tests/
!/docs/

# Vendored MinHook 1.3.4: the sources the build compiles, plus its license and readme
!/third_party/
/third_party/minhook/*
!/third_party/minhook/include/
!/third_party/minhook/src/
!/third_party/minhook/LICENSE.txt
!/third_party/minhook/AUTHORS.txt
!/third_party/minhook/README.md

# Generator for src/nrsc/signatures/signature_table.inc and its input (used by build.sh and the tests)
!/tools/
/tools/*
!/tools/gen_signature_table.py
!/evidence/
/evidence/*
!/evidence/signatures/
/evidence/signatures/*
!/evidence/signatures/signatures.json

# Package template copied by build.sh, and the in-game test instructions
!/dist/
/dist/*
!/dist/TESTING.md
!/dist/SeamlessCoop/
/dist/SeamlessCoop/*
!/dist/SeamlessCoop/nrsc_settings.ini
!/dist/SeamlessCoop/nrsc_disable_hooks.txt
!/dist/SeamlessCoop/locale/

__pycache__/
*.pyc
